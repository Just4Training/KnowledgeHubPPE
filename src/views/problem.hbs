<div class="jumbotron">
  <h2 class="display-4">{{ problem.problemName }}<span class="badge badge-secondary">{{ problem.level }}</span></h2>
  <p class="lead">{{ problem.description }}</p>
  <hr class="my-4">
  <h4><span class="badge badge-primary">Topic: {{ problem.topic }}</span></h4>
  <h4><span class="badge badge-info">LeetCode: {{ problem.leetcode }}</span></h4>
  <div class="container mt-3">
    <h3>Code</h3>
    <div class="bg-white border border-info p-2 rounded">
        <pre><code class="language-javascript" id="code">
        </code></pre>
    </div>
  </div>
  <div class="form-group">
    <form action="/algorithms/upload" method="post" enctype="multipart/form-data">
        <label for="fileInput">Choose a .js file</label>
        <input type="file" class="form-control-file" id="fileInput" name="file">
        <input type="submit" class="btn btn-primary">Upload File</button>
    </form>
  </div>


</div>

